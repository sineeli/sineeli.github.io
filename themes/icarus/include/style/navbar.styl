/* ---------------------------------
 *           Top Navigation
 * --------------------------------- */
$navbar-item-padding-v ?= 0.375rem
$navbar-item-padding-h ?= .75rem
$navbar-item-margin-v ?= 0
$navbar-item-margin-h ?= 0

.navbar-main
    box-shadow: $shadow

    .navbar-container
        display: flex
        flex-wrap: wrap
        align-items: stretch

    .navbar-brand
        display: flex
        align-items: center
        flex-shrink: 0

        .navbar-burger
            display: none
            color: inherit
            cursor: pointer
            height: 3.25rem
            width: 3.25rem
            margin-left: auto
            position: relative
            align-items: center
            justify-content: center

            span
                background-color: currentColor
                display: block
                height: 1px
                left: calc(50% - 8px)
                position: absolute
                width: 16px
                transition: all 0.15s ease-out

                &:nth-child(1)
                    top: calc(50% - 6px)

                &:nth-child(2)
                    top: calc(50% - 1px)

                &:nth-child(3)
                    top: calc(50% + 4px)

            &.is-active span:nth-child(1)
                transform: translateY(5px) rotate(45deg)

            &.is-active span:nth-child(2)
                opacity: 0

            &.is-active span:nth-child(3)
                transform: translateY(-5px) rotate(-45deg)

    // Desktop: show menu inline, hide burger
    +from($desktop)
        .navbar-burger
            display: none !important

        .navbar-menu
            display: flex !important
            align-items: stretch
            flex-grow: 1
            flex-shrink: 0

        .navbar-start, .navbar-end
            display: flex
            align-items: stretch

    // Mobile/Tablet: show burger, hide menu by default
    +until($desktop)
        .navbar-brand
            width: 100%
            justify-content: space-between

        .navbar-burger
            display: flex !important

        .navbar-menu
            display: none
            width: 100%
            flex-direction: column
            padding: 0.5rem 0
            background: inherit

            &.is-active
                display: block

        .navbar-start, .navbar-end
            display: flex
            flex-direction: column

        .navbar-item
            padding: 0.75rem 1rem

    .navbar-start
        justify-content: flex-start
        margin-right: auto

    .navbar-end
        justify-content: flex-end
        margin-left: auto

    .navbar-item
        display: flex
        align-items: center
        padding: $navbar-item-padding-v $navbar-item-padding-h
        margin: $navbar-item-margin-v $navbar-item-margin-h

        &.is-active
            background-color: transparent

.navbar-logo
    img
        max-height: $logo-height

@media screen and (min-width: $desktop)
    .navbar > .container .navbar-menu, .container > .navbar .navbar-menu
        margin-right: 0rem
