/* ---------------------------------
 *         Dark Mode Styles
 * --------------------------------- */

/* CSS Custom Properties for theming */
:root
    --bg-primary: #ffffff
    --bg-secondary: #f5f5f5
    --bg-tertiary: #e0e0e0
    --text-primary: #000000
    --text-secondary: #4a4a4a
    --text-tertiary: #767676
    --border-color: #dbdbdb
    --link-color: #3273dc
    --link-hover: #363636
    --card-bg: #ffffff
    --navbar-bg: #ffffff
    --footer-bg: #fafafa
    --code-bg: #f5f5f5
    --highlight-bg: #fafafa

.dark-mode
    --bg-primary: #0d1117
    --bg-secondary: #161b22
    --bg-tertiary: #21262d
    --text-primary: #c9d1d9
    --text-secondary: #8b949e
    --text-tertiary: #6e7681
    --border-color: #30363d
    --link-color: #58a6ff
    --link-hover: #79c0ff
    --card-bg: #161b22
    --navbar-bg: #161b22
    --footer-bg: #161b22
    --code-bg: #21262d
    --highlight-bg: #1e1e1e

/* Add smooth transition for theme changes */
html, body, .card, .navbar-main, .footer, a, .content, .title, p, h1, h2, h3, h4, h5, h6, span
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease

/* Dark mode base styles */
.dark-mode
    background: var(--bg-primary)
    color: var(--text-primary)

    *, *::before, *::after
        border-color: var(--border-color)

    body
        background: var(--bg-primary)
        color: var(--text-primary)

    .navbar-main
        background: var(--navbar-bg)
        border-bottom: 1px solid var(--border-color)

    .card
        background: var(--card-bg)
        border: 1px solid var(--border-color)
        color: var(--text-primary)

    .footer
        background: var(--footer-bg)
        border-top: 1px solid var(--border-color)
        color: var(--text-primary)

    /* Dark mode link colors - bright blue for better visibility */
    a
        color: #58a6ff

        &:hover
            color: #79c0ff

    /* Dark mode text colors - ensure all text is visible */
    .content
        color: #c9d1d9

    .title
        color: #e6eef8

    .subtitle
        color: #c9d1d9

    p, span, div
        color: #c9d1d9

    h1, h2, h3, h4, h5, h6
        color: #e6eef8

    /* Widget and card text */
    .widget
        .menu-label
            color: #e6eef8

        .heading
            color: #8b949e

    .card-header-title
        color: #e6eef8

    .card-content
        color: #c9d1d9

    /* Navbar items */
    .navbar-item
        color: #c9d1d9

        &:hover
            color: #e6eef8
            background-color: rgba(48, 54, 61, 0.5)

        &.is-active
            color: #58a6ff
            background-color: rgba(48, 54, 61, 0.5)
            border-bottom: 2px solid #58a6ff

    /* Metadata and dates */
    .date, .categories, .is-size-7
        color: #8b949e

    /* Photography title/link adjustments */
    .card .title a.has-link-black-ter
        color: #e6eef8

        &:hover
            color: #58a6ff

    /* Post title styling - blue by default, white on hover */
    .card .title a,
    .card .title a.link-muted
        color: #58a6ff !important

        &:hover
            color: #fff !important

    /* Post card separator line */
    .card-content hr,
    .content hr
        background-color: #3a3a3a

    /* Buttons and inputs */
    .button
        background: #21262d
        color: #c9d1d9
        border-color: #30363d

        &:hover
            background: #30363d
            color: #e6eef8

    input, textarea
        background: #0d1117
        color: #c9d1d9
        border-color: #30363d

        &::placeholder
            color: #8b949e

    /* Tags and labels */
    .tag
        background: #21262d
        color: #c9d1d9

    .menu-list a
        color: #c9d1d9

        &:hover
            background: #21262d
            color: #e6eef8

    /* Notifications and messages */
    .notification
        background: #161b22
        color: #c9d1d9

    code
        background: #21262d
        color: #ff7b72

    pre
        background: #161b22
        color: #c9d1d9

    /* Timeline (archives page) */
    .timeline
        border-left-color: #30363d

        .media:before
            background: #30363d

        .media:last-child:after
            background: #161b22

    /* Read more button and muted links */
    .article-more
        background: #21262d !important
        color: #58a6ff !important
        border-color: #30363d !important

        &:hover
            background: #30363d !important
            color: #79c0ff !important
            border-color: #58a6ff !important

        .has-text-grey
            color: #8b949e !important

    .link-muted
        color: #8b949e

        &:hover
            color: #58a6ff

    /* Article navigation links */
    .article-nav-prev, .article-nav-next
        color: #8b949e

        &:hover
            color: #58a6ff

    /* Code blocks in dark mode */
    figure.highlight
        background: #1e1e1e !important
        border: 1px solid #404040 !important

        pre
            background: #1e1e1e !important
            color: #d4d4d4 !important

        code
            background: #1e1e1e !important
            color: #d4d4d4 !important

        figcaption
            background: #2d2d2d !important
            color: #cccccc !important
            border-bottom: 1px solid #404040

        .gutter
            background: #2d2d2d !important
            color: #858585 !important

            pre
                color: #858585 !important

        table
            background: #1e1e1e !important

    /* Inline code in dark mode */
    .content code:not(.hljs)
        background: #2d2d2d !important
        color: #f8f8f2 !important

    /* Article licensing in dark mode */
    .article-licensing
        background: #21262d !important
        border: 1px solid #30363d !important

        .licensing-title,
        .licensing-title p
            color: #e6eef8 !important

        h6
            color: #8b949e !important

        p
            color: #c9d1d9 !important

        a
            color: #58a6ff !important

    /* Remove button box borders in dark mode */
    .button.is-transparent
        background: transparent !important
        border: none !important
        box-shadow: none !important

    .level-item.button
        background: transparent !important
        border: none !important
        box-shadow: none !important

/* Light mode specific styles */
.card .title a.has-link-black-ter
    color: #111
    transition: color 0.18s ease, transform 0.12s ease

    &:hover
        transform: translateY(-2px)

.card .title a,
.card .title a.link-muted
    color: #58a6ff !important
    transition: color 0.2s ease
    transform: none !important

    &:hover
        color: #111 !important
        transform: none !important

/* Make post titles smaller */
.card .title.is-3
    font-size: 1.5rem !important

    &.is-size-4-mobile
        font-size: 1.25rem !important

+mobile()
    .card .title.is-3.is-size-4-mobile
        font-size: 1.1rem !important

/* Make page headings (Blogs, Photography, etc.) bigger */
.card-content > .title.is-3:first-child,
.content > .title.is-3:first-child
    font-size: 2.25rem !important

/* Center share buttons */
.a2a_kit
    display: flex !important
    justify-content: center !important
    align-items: center !important
    min-height: 32px
    margin-top: 1rem
    
    /* Show placeholders before script loads */
    a
        display: inline-block
        width: 32px
        height: 32px
        margin: 0 4px
        background-color: #0166ff
        border-radius: 4px
        
        &:hover
            opacity: 0.8

/* Dark mode share button styles */
.dark-mode
    /* AddToAny share buttons - the icons already have colors, just adjust brightness */
    .a2a_kit a
        opacity: 0.9
        
        &:hover
            opacity: 1
    
    /* Cookie Consent popup in dark mode */
    .cc-window
        background: #161b22 !important
        border: 1px solid #30363d !important
        color: #c9d1d9 !important
    
    .cc-message
        color: #c9d1d9 !important
    
    .cc-link
        color: #58a6ff !important
        
        &:hover
            color: #79c0ff !important
    
    .cc-btn
        background: #21262d !important
        color: #c9d1d9 !important
        border-color: #30363d !important
        
        &:hover
            background: #30363d !important
            color: #e6eef8 !important
    
    .cc-allow, .cc-dismiss
        background: #238636 !important
        
        &:hover
            background: #2ea043 !important
    
    .cc-deny
        background: #da3633 !important
        
        &:hover
            background: #e5534b !important
    
    /* Gallery (lightGallery) in dark mode */
    .lg-backdrop
        background-color: rgba(13, 17, 23, 0.95) !important
    
    .lg-outer
        background-color: #0d1117 !important
    
    .lg-toolbar, .lg-actions
        background-color: rgba(22, 27, 34, 0.8) !important
    
    .lg-sub-html
        background-color: rgba(22, 27, 34, 0.9) !important
        color: #c9d1d9 !important
    
    /* Progress bar in dark mode */
    #nprogress .bar
        background: #58a6ff !important
    
    #nprogress .peg
        box-shadow: 0 0 10px #58a6ff, 0 0 5px #58a6ff !important
    
    #nprogress .spinner-icon
        border-top-color: #58a6ff !important
        border-left-color: #58a6ff !important
    
    /* Back to top button in dark mode */
    #back-to-top
        background: #21262d !important
        color: #c9d1d9 !important
        border-color: #30363d !important
        
        &:hover
            background: #30363d !important
            color: #58a6ff !important
    
    /* Insight search (alternative search UI) */
    .ins-search
        background: rgba(13, 17, 23, 0.95) !important
    
    .ins-search-wrapper
        background: #161b22 !important
        border-color: #30363d !important
    
    .ins-input-wrapper
        background: #161b22 !important
        border-color: #30363d !important
    
    .ins-input
        background: transparent !important
        color: #c9d1d9 !important
        
        &::placeholder
            color: #8b949e !important
    
    .ins-section-wrapper
        background: #161b22 !important
    
    .ins-section-header
        background: #21262d !important
        color: #e6eef8 !important
        border-color: #30363d !important
    
    .ins-selectable
        color: #c9d1d9 !important
        
        &:hover, &.active
            background: #21262d !important
            color: #58a6ff !important
    
    .ins-slug
        color: #8b949e !important
    
    /* TOC (Table of Contents) widget in dark mode */
    .toc
        background: #161b22 !important
        border-color: #30363d !important
    
    .toc-link
        color: #8b949e !important
        
        &:hover
            color: #58a6ff !important
        
        &.is-active-link
            color: #58a6ff !important
    
    .toc-item
        border-color: #30363d !important
    
    /* Widget boxes in dark mode */
    .widget
        .menu-list a
            color: #8b949e !important
            
            &:hover
                background: #21262d !important
                color: #58a6ff !important
                
            &.is-active
                background: #21262d !important
                color: #58a6ff !important

/* Post card separator line - lighter gray */
.card-content hr,
.content hr
    background-color: #e0e0e0
    border: none
    height: 1px
