/* ---------------------------------
 *         Dark Mode Styles
 * --------------------------------- */

/* CSS Custom Properties for theming */
:root
    --bg-primary: #ffffff
    --bg-secondary: #f5f5f5
    --bg-tertiary: #e0e0e0
    --text-primary: #000000
    --text-secondary: #4a4a4a
    --text-tertiary: #767676
    --border-color: #dbdbdb
    --link-color: #3273dc
    --link-hover: #363636
    --card-bg: #ffffff
    --navbar-bg: #ffffff
    --footer-bg: #fafafa
    --code-bg: #f5f5f5
    --highlight-bg: #fafafa
    --mark-bg: #fff59d
    --mark-color: #000000

.dark-mode
    --bg-primary: #0d1117
    --bg-secondary: #161b22
    --bg-tertiary: #21262d
    --text-primary: #c9d1d9
    --text-secondary: #8b949e
    --text-tertiary: #6e7681
    --border-color: #30363d
    --link-color: #58a6ff
    --link-hover: #79c0ff
    --card-bg: #161b22
    --navbar-bg: #161b22
    --footer-bg: #161b22
    --code-bg: #21262d
    --highlight-bg: #1e1e1e
    --mark-bg: #634d00
    --mark-color: #f0e68c

/* Smooth transition for theme changes */
html, body, .card, .navbar-main, .footer, a, .content, .title, p, h1, h2, h3, h4, h5, h6, span, blockquote, code, pre, table, th, td
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease

/* =============================================
   DARK MODE - All styles scoped under .dark-mode
   ============================================= */

.dark-mode
    background: var(--bg-primary)
    color: var(--text-primary)

    /* Global border color override */
    *, *::before, *::after
        border-color: var(--border-color)

    body
        background: var(--bg-primary)
        color: var(--text-primary)

    /* ----- Layout Components ----- */
    .navbar-main
        background: var(--navbar-bg)
        border-bottom: 1px solid var(--border-color)

    .card
        background: var(--card-bg)
        border: 1px solid var(--border-color)
        color: var(--text-primary)

    .footer
        background: var(--footer-bg)
        border-top: 1px solid var(--border-color)
        color: var(--text-primary)

    /* ----- Links ----- */
    a
        color: var(--link-color)

        &:hover
            color: var(--link-hover)

    /* ----- Typography ----- */
    .title
        color: #e6eef8 !important

    .subtitle
        color: var(--text-primary)

    h1, h2, h3, h4, h5, h6
        color: #e6eef8 !important

    p, span, li
        color: var(--text-primary)

    /* ----- Content Area (Article/Post Body) ----- */
    .content
        color: var(--text-primary)

        /* Headings inside content */
        h1, h2, h3, h4, h5, h6
            color: #e6eef8 !important

        /* Paragraphs and text */
        p, li, span
            color: var(--text-primary) !important

        /* Bold text */
        strong, b
            color: #e6eef8 !important
            font-weight: 700

        /* Italic text */
        em, i
            color: var(--text-primary)

        /* Links in content */
        a
            color: var(--link-color) !important

            &:hover
                color: var(--link-hover) !important

        /* ----- Blockquotes ----- */
        blockquote
            background: var(--bg-tertiary) !important
            border-left: 5px solid var(--border-color) !important
            color: var(--text-primary) !important

            p, span, strong, em, a, code
                color: var(--text-primary) !important

            strong, b
                color: #e6eef8 !important
                font-weight: 700

            code
                background: var(--code-bg) !important
                color: #ff7b72 !important
                padding: 0.15em 0.4em !important

        /* ----- Inline Code ----- */
        code:not(.hljs)
            background: var(--code-bg) !important
            color: #ff7b72 !important
            padding: 0.15em 0.4em
            border-radius: 3px

        /* ----- Pre/Code blocks ----- */
        pre
            background: var(--highlight-bg) !important
            color: var(--text-primary) !important

            code
                background: transparent !important
                color: inherit !important

        /* ----- Horizontal Rules ----- */
        hr
            background-color: var(--border-color) !important
            border: none
            height: 1px

        /* ----- Tables ----- */
        table
            background: var(--bg-secondary) !important

            th
                background: var(--bg-tertiary) !important
                color: #e6eef8 !important
                border-color: var(--border-color) !important

            td
                background: var(--bg-secondary) !important
                color: var(--text-primary) !important
                border-color: var(--border-color) !important

            tr:nth-child(even) td
                background: var(--bg-tertiary) !important

        /* ----- Highlighted/Marked Text ----- */
        mark
            background: var(--mark-bg) !important
            color: var(--mark-color) !important
            padding: 0.1em 0.3em
            border-radius: 2px

        /* ----- Keyboard Input ----- */
        kbd
            background: var(--bg-tertiary) !important
            color: var(--text-primary) !important
            border: 1px solid var(--border-color) !important
            border-radius: 3px
            padding: 0.1em 0.4em
            font-family: monospace
            box-shadow: 0 1px 0 var(--border-color)

        /* ----- Definition Lists ----- */
        dl
            dt
                color: #e6eef8 !important
                font-weight: 600

            dd
                color: var(--text-primary) !important

        /* ----- Ordered/Unordered Lists ----- */
        ul, ol
            color: var(--text-primary)

            li
                color: var(--text-primary) !important

                &::marker
                    color: var(--text-secondary)

        /* ----- Abbreviations ----- */
        abbr
            color: var(--text-primary) !important
            border-bottom: 1px dotted var(--text-secondary)

        /* ----- Subscript/Superscript ----- */
        sub, sup
            color: var(--text-primary) !important

        /* ----- Deleted/Inserted Text ----- */
        del, s
            color: var(--text-secondary) !important

        ins
            color: var(--text-primary) !important
            text-decoration: underline

        /* ----- Images ----- */
        img
            opacity: 0.95

        figcaption
            color: var(--text-secondary) !important

    /* ----- Code Blocks (figure.highlight) ----- */
    figure.highlight
        background: var(--highlight-bg) !important
        border: 1px solid #404040 !important

        pre
            background: var(--highlight-bg) !important
            color: #d4d4d4 !important

        code
            background: var(--highlight-bg) !important
            color: #d4d4d4 !important

        figcaption
            background: var(--bg-tertiary) !important
            color: #cccccc !important
            border-bottom: 1px solid #404040

        .gutter
            background: var(--bg-tertiary) !important
            color: #858585 !important

            pre
                color: #858585 !important

        table
            background: var(--highlight-bg) !important

        /* Code block action buttons */
        .copy, .fold
            color: var(--text-secondary) !important

            &:hover
                color: var(--link-color) !important

        /* ----- Highlight.js Syntax Highlighting (atom-one-dark colors) ----- */
        /* Base code text - don't override individual token colors */
        .code pre
            color: #abb2bf !important

        /* Keywords: if, else, for, while, return, from, import, def, class, async, await, etc. */
        .hljs-keyword
            color: #c678dd !important

        /* Built-in functions and types */
        .hljs-built_in
            color: #e5c07b !important

        /* Strings */
        .hljs-string
            color: #98c379 !important

        /* Numbers */
        .hljs-number
            color: #d19a66 !important

        /* Comments */
        .hljs-comment
            color: #5c6370 !important
            font-style: italic

        /* Functions and methods */
        .hljs-function
            color: #61afef !important

        /* Classes and types */
        .hljs-class, .hljs-type
            color: #e5c07b !important

        /* Title (function/class names in definitions) */
        .hljs-title
            color: #61afef !important

        /* Function titles specifically */
        .hljs-title.hljs-function_
            color: #61afef !important

        /* Class titles specifically */
        .hljs-title.hljs-class_
            color: #e5c07b !important

        /* Parameters */
        .hljs-params
            color: #abb2bf !important

        /* Operators */
        .hljs-operator
            color: #56b6c2 !important

        /* Variables */
        .hljs-variable
            color: #e06c75 !important

        /* Attributes and properties */
        .hljs-attr, .hljs-attribute
            color: #d19a66 !important

        /* Regular expressions */
        .hljs-regexp
            color: #98c379 !important

        /* Meta information (decorators, preprocessor, etc.) */
        .hljs-meta
            color: #61afef !important

        /* Tags (HTML/XML) */
        .hljs-tag
            color: #e06c75 !important

        /* Tag names */
        .hljs-name
            color: #e06c75 !important

        /* Symbols */
        .hljs-symbol
            color: #56b6c2 !important

        /* Literals (True, False, None, null, etc.) */
        .hljs-literal
            color: #d19a66 !important

        /* Constants */
        .hljs-constant
            color: #d19a66 !important

        /* Punctuation */
        .hljs-punctuation
            color: #abb2bf !important

        /* Links */
        .hljs-link
            color: #61afef !important
            text-decoration: underline

        /* Additions (diff) */
        .hljs-addition
            color: #98c379 !important
            background: rgba(152, 195, 121, 0.1) !important

        /* Deletions (diff) */
        .hljs-deletion
            color: #e06c75 !important
            background: rgba(224, 108, 117, 0.1) !important

        /* Section headers */
        .hljs-section
            color: #e5c07b !important

        /* Bash/Shell specific - shebang */
        .hljs-shebang
            color: #5c6370 !important

        /* Python specific - decorator */
        .hljs-decorator
            color: #e5c07b !important

        /* JavaScript/TypeScript specific */
        .hljs-template-variable
            color: #e06c75 !important

        .hljs-template-string
            color: #98c379 !important

        /* JSON/Object keys */
        .hljs-property
            color: #e06c75 !important

        /* YAML/TOML keys */
        .hljs-bullet
            color: #d19a66 !important

        /* CSS specific */
        .hljs-selector-tag
            color: #e06c75 !important

        .hljs-selector-class
            color: #e5c07b !important

        .hljs-selector-id
            color: #61afef !important

        /* Doctypes and XML declarations */
        .hljs-doctag
            color: #c678dd !important

        /* Strong emphasis */
        .hljs-strong
            font-weight: bold
            color: #e5c07b !important

        /* Emphasis */
        .hljs-emphasis
            font-style: italic
            color: #c678dd !important

        /* Subst (template substitutions) */
        .hljs-subst
            color: #abb2bf !important

        /* Code (inline code in markdown) */
        .hljs-code
            color: #98c379 !important

        /* Quote */
        .hljs-quote
            color: #5c6370 !important
            font-style: italic

    /* ----- Article Licensing Box ----- */
    .article-licensing
        background: var(--bg-tertiary) !important
        border: 1px solid var(--border-color) !important

        .licensing-title,
        .licensing-title p
            color: #e6eef8 !important

        h6
            color: var(--text-secondary) !important

        p
            color: var(--text-primary) !important

        a
            color: var(--link-color) !important

    /* ----- Card Components ----- */
    .card-header-title
        color: #e6eef8

    .card-content
        color: var(--text-primary)

        hr
            background-color: var(--border-color) !important

    /* Post title links */
    .card .title a,
    .card .title a.link-muted
        color: var(--link-color) !important

        &:hover
            color: #ffffff !important

    .card .title a.has-link-black-ter
        color: #e6eef8

        &:hover
            color: var(--link-color)

    /* ----- Navbar ----- */
    .navbar-item
        color: var(--text-primary)

        &:hover
            color: #e6eef8
            background-color: rgba(48, 54, 61, 0.5)

        &.is-active
            color: var(--link-color)
            background-color: rgba(48, 54, 61, 0.5)
            border-bottom: 2px solid var(--link-color)

    /* ----- Widgets ----- */
    .widget
        .menu-label
            color: #e6eef8

        .heading
            color: var(--text-secondary)

        .menu-list a
            color: var(--text-secondary) !important

            &:hover
                background: var(--bg-tertiary) !important
                color: var(--link-color) !important

            &.is-active
                background: var(--bg-tertiary) !important
                color: var(--link-color) !important

    /* ----- Form Elements ----- */
    .button
        background: var(--bg-tertiary)
        color: var(--text-primary)
        border-color: var(--border-color)

        &:hover
            background: #30363d
            color: #e6eef8

        &.is-transparent
            background: transparent !important
            border: none !important
            box-shadow: none !important

    .level-item.button
        background: transparent !important
        border: none !important
        box-shadow: none !important

    input, textarea, select
        background: var(--bg-primary)
        color: var(--text-primary)
        border-color: var(--border-color)

        &::placeholder
            color: var(--text-secondary)

    /* ----- Tags ----- */
    .tag
        background: var(--bg-tertiary)
        color: var(--text-primary)

    /* ----- Metadata ----- */
    .date, .categories, .is-size-7
        color: var(--text-secondary)

    .link-muted
        color: var(--text-secondary)

        &:hover
            color: var(--link-color)

    /* ----- Notifications ----- */
    .notification
        background: var(--bg-secondary)
        color: var(--text-primary)

    /* ----- Timeline (Archives) ----- */
    .timeline
        border-left-color: var(--border-color)

        .media:before
            background: var(--border-color)

        .media:last-child:after
            background: var(--bg-secondary)

    /* ----- Article Navigation ----- */
    .article-nav-prev, .article-nav-next
        color: var(--text-secondary)

        &:hover
            color: var(--link-color)

    .article-more
        background: var(--bg-tertiary) !important
        color: var(--link-color) !important
        border-color: var(--border-color) !important

        &:hover
            background: #30363d !important
            color: var(--link-hover) !important
            border-color: var(--link-color) !important

        .has-text-grey
            color: var(--text-secondary) !important

    /* ----- TOC (Table of Contents) ----- */
    .toc
        background: var(--bg-secondary) !important
        border-color: var(--border-color) !important

    .toc-link
        color: var(--text-secondary) !important

        &:hover
            color: var(--link-color) !important

        &.is-active-link
            color: var(--link-color) !important

    .toc-item
        border-color: var(--border-color) !important

    /* ----- Search (Insight) ----- */
    .ins-search
        background: rgba(13, 17, 23, 0.95) !important

    .ins-search-wrapper
        background: var(--bg-secondary) !important
        border-color: var(--border-color) !important

    .ins-input-wrapper
        background: var(--bg-secondary) !important
        border-color: var(--border-color) !important

    .ins-input
        background: transparent !important
        color: var(--text-primary) !important

        &::placeholder
            color: var(--text-secondary) !important

    .ins-section-wrapper
        background: var(--bg-secondary) !important

    .ins-section-header
        background: var(--bg-tertiary) !important
        color: #e6eef8 !important
        border-color: var(--border-color) !important

    .ins-selectable
        color: var(--text-primary) !important

        &:hover, &.active
            background: var(--bg-tertiary) !important
            color: var(--link-color) !important

    .ins-slug
        color: var(--text-secondary) !important

    /* Search box styles */
    .searchbox
        background: rgba(13, 17, 23, 0.95) !important

    .searchbox-container
        background: var(--bg-secondary) !important
        border-color: var(--border-color) !important

    .searchbox-header
        background: var(--bg-tertiary) !important
        border-color: var(--border-color) !important

    .searchbox-input
        background: var(--bg-secondary) !important
        color: var(--text-primary) !important

        &::placeholder
            color: var(--text-secondary) !important

    .searchbox-body
        background: var(--bg-secondary) !important
        color: var(--text-primary) !important

    /* ----- Cookie Consent ----- */
    .cc-window
        background: var(--bg-secondary) !important
        border: 1px solid var(--border-color) !important
        color: var(--text-primary) !important

    .cc-message
        color: var(--text-primary) !important

    .cc-link
        color: var(--link-color) !important

        &:hover
            color: var(--link-hover) !important

    .cc-btn
        background: var(--bg-tertiary) !important
        color: var(--text-primary) !important
        border-color: var(--border-color) !important

        &:hover
            background: #30363d !important
            color: #e6eef8 !important

    .cc-allow, .cc-dismiss
        background: #238636 !important

        &:hover
            background: #2ea043 !important

    .cc-deny
        background: #da3633 !important

        &:hover
            background: #e5534b !important

    /* ----- Gallery (LightGallery) ----- */
    .lg-backdrop
        background-color: rgba(13, 17, 23, 0.95) !important

    .lg-outer
        background-color: var(--bg-primary) !important

    .lg-toolbar, .lg-actions
        background-color: rgba(22, 27, 34, 0.8) !important

    .lg-sub-html
        background-color: rgba(22, 27, 34, 0.9) !important
        color: var(--text-primary) !important

    /* ----- Back to Top Button ----- */
    #back-to-top
        background: var(--bg-tertiary) !important
        color: var(--text-primary) !important
        border-color: var(--border-color) !important

        &:hover
            background: #30363d !important
            color: var(--link-color) !important

    /* ----- Share Buttons (AddToAny) ----- */
    .a2a_kit a
        opacity: 0.9

        &:hover
            opacity: 1

    /* ----- Progress Bar ----- */
    #nprogress .bar
        background: var(--link-color) !important

    #nprogress .peg
        box-shadow: 0 0 10px var(--link-color), 0 0 5px var(--link-color) !important

    #nprogress .spinner-icon
        border-top-color: var(--link-color) !important
        border-left-color: var(--link-color) !important

    /* ----- Pace Loading Bar ----- */
    .pace .pace-progress
        background: var(--link-color) !important


/* =============================================
   LIGHT MODE - Base/Default styles
   ============================================= */

/* Post title links - light mode */
.card .title a.has-link-black-ter
    color: #111
    transition: color 0.18s ease

    &:hover
        color: var(--link-color)

.card .title a,
.card .title a.link-muted
    color: var(--link-color) !important
    transition: color 0.2s ease

    &:hover
        color: #111 !important

/* Post titles sizing */
.card .title.is-3
    font-size: 1.5rem !important

    &.is-size-4-mobile
        font-size: 1.25rem !important

+mobile()
    .card .title.is-3.is-size-4-mobile
        font-size: 1.1rem !important

/* Page headings */
.card-content > .title.is-3:first-child,
.content > .title.is-3:first-child
    font-size: 2.25rem !important

/* Share buttons centering */
.a2a_kit
    display: flex !important
    justify-content: center !important
    align-items: center !important
    min-height: 32px
    margin-top: 1rem

    a
        display: inline-block
        width: 32px
        height: 32px
        margin: 0 4px
        background-color: #0166ff
        border-radius: 4px

        &:hover
            opacity: 0.8

/* HR styling for light mode */
.card-content hr,
.content hr
    background-color: #e0e0e0
    border: none
    height: 1px
